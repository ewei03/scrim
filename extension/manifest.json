{
  "manifest_version": 3,
  "name": "Scrim",
  "version": "0.7.0",
  "description": "A daily puzzle showdown between you and your friends.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://khvrnfpnsivqutawqzut.supabase.co/*",
    "https://www.nytimes.com/games/*",
    "https://krillion.io/*",
    "https://contexto.me/*",
    "https://costcodle.com/*",
    "https://www.costcodle.com/*",
    "https://poople.io/*",
    "https://minicrossword.com/*",
    "https://www.minicrossword.com/*",
    "https://worldle.teuteuf.fr/*",
    "https://globle-game.com/*",
    "https://www.globle-game.com/*",
    "https://wafflegame.net/*",
    "https://www.wafflegame.net/*",
    "https://nerdlegame.com/*",
    "https://perceptle.com/*",
    "https://www.perceptle.com/*",
    "https://minecraftdle.com/*",
    "https://www.minecraftdle.com/*",
    "https://angledle.com/*",
    "https://www.angledle.com/*",
    "https://daily-scrim.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/wordle*"
      ],
      "js": [
        "scrim-content.js",
        "wordle-core.js",
        "nyt-wordle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nytimes.com/games/connections*"
      ],
      "js": [
        "scrim-content.js",
        "connections-core.js",
        "nyt-connections.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nytimes.com/games/strands*"
      ],
      "js": [
        "scrim-content.js",
        "strands-core.js",
        "nyt-strands.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://krillion.io/*"
      ],
      "js": [
        "scrim-content.js",
        "krillion-core.js",
        "krillion.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://contexto.me/*"
      ],
      "js": [
        "scrim-content.js",
        "contexto-core.js",
        "contexto.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://costcodle.com/*",
        "https://www.costcodle.com/*"
      ],
      "js": [
        "scrim-content.js",
        "costcodle-core.js",
        "costcodle-classic-core.js",
        "costcodle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poople.io/*"
      ],
      "js": [
        "scrim-content.js",
        "poople-core.js",
        "poople.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://minicrossword.com/*",
        "https://www.minicrossword.com/*"
      ],
      "js": [
        "scrim-content.js",
        "mini-core.js",
        "mini.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://worldle.teuteuf.fr/*"
      ],
      "js": [
        "scrim-content.js",
        "worldle-core.js",
        "worldle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://globle-game.com/*",
        "https://www.globle-game.com/*"
      ],
      "js": [
        "scrim-content.js",
        "globle-core.js",
        "globle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wafflegame.net/*",
        "https://www.wafflegame.net/*"
      ],
      "js": [
        "scrim-content.js",
        "waffle-core.js",
        "waffle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nerdlegame.com/*"
      ],
      "js": [
        "scrim-content.js",
        "nerdle-core.js",
        "nerdle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://perceptle.com/*",
        "https://www.perceptle.com/*"
      ],
      "js": [
        "scrim-content.js",
        "perceptle-core.js",
        "perceptle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://minecraftdle.com/*",
        "https://www.minecraftdle.com/*"
      ],
      "js": [
        "scrim-content.js",
        "minecraftdle-core.js",
        "minecraftdle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://angledle.com/*",
        "https://www.angledle.com/*"
      ],
      "js": [
        "scrim-content.js",
        "angledle-core.js",
        "angledle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://daily-scrim.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "scrim-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrim",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
