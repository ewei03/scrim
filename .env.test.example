# Copy to .env.test.local (git-ignored) for `npm run e2e`. See e2e/README.md.
# Two email + password users, made in Supabase → Authentication → Users → Add user
# (tick "Auto Confirm User"). Use throwaway passwords: these are test accounts only.
E2E_OWNER_EMAIL=scrim-e2e-owner@example.com
E2E_OWNER_PASSWORD=
E2E_FRIEND_EMAIL=scrim-e2e-friend@example.com
E2E_FRIEND_PASSWORD=

# Optional: a separate Supabase project for the tests, so they don't make rows
# in the live one. Run every file in supabase/migrations/ on it first, and make
# the two users above there. Leave blank to use the project in .env.local.
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
