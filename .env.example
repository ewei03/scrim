# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google Cloud → APIs & Services → Credentials → your OAuth web client's ID.
# Optional: without it, Google sign-in falls back to Supabase's redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
